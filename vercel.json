{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/open-solucoes-tributarias", "destination": "https://www.opensolucoestributarias.com.br/", "permanent": true },
    { "source": "/open-solucoes-tributarias/:path*", "destination": "https://www.opensolucoestributarias.com.br/", "permanent": true }
  ],
  "headers": [
    { "source": "/_next/static/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/optimized/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/optimized-video/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
